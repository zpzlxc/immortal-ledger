{
  "name": "immortal-ledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:migrate:local": "wrangler d1 migrations apply zpzlxc --local --config worker/wrangler.toml",
    "worker:migrate:remote": "wrangler d1 migrations apply zpzlxc --remote --config worker/wrangler.toml",
    "worker:build": "tsc -b && vite build --mode worker",
    "worker:deploy": "npm run worker:build && wrangler deploy --config worker/wrangler.toml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "miniflare": "5.20260826.0-alpha",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
